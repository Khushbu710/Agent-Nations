# =============================================================================
# Agent Nations — Contracts Environment Variables
# =============================================================================
# Copy this file to .env and fill in all values before deploying.
# NEVER commit .env to version control. It is already in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Deployer wallet
# -----------------------------------------------------------------------------
# Private key of the wallet that will deploy the contract and hold
# DEFAULT_ADMIN_ROLE. This wallet pays the deployment gas fee.
# Fund it with Base Sepolia ETH: https://faucet.quicknode.com/base/sepolia
# Format: 0x-prefixed 64-character hex string
DEPLOYER_PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY_HERE

# -----------------------------------------------------------------------------
# Executor wallet
# -----------------------------------------------------------------------------
# Address (not private key) of the backend hot wallet that will be granted
# EXECUTOR_ROLE and will submit AI decisions each cycle.
# During development this can be the same address as the deployer.
# Format: 0x-prefixed 40-character hex address
EXECUTOR_ADDRESS=0xYOUR_EXECUTOR_WALLET_ADDRESS_HERE

# -----------------------------------------------------------------------------
# RPC URLs
# -----------------------------------------------------------------------------
# Base Sepolia RPC endpoint. Using a private Alchemy or QuickNode key is
# strongly recommended over the public endpoint for hackathon reliability.
#
# Get a free Alchemy key: https://alchemy.com
# Get a free QuickNode key: https://quicknode.com
#
# Alchemy format:   https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
# QuickNode format: https://YOUR_ENDPOINT.base-sepolia.quiknode.pro/YOUR_KEY/
# Public fallback:  https://sepolia.base.org  (do not use for demos)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Base Mainnet (for post-hackathon use only)
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# -----------------------------------------------------------------------------
# Contract verification
# -----------------------------------------------------------------------------
# Basescan API key for verifying the contract source code on the explorer.
# This is optional but recommended — verified contracts look more credible
# to judges.
# Get a free key: https://basescan.org/myapikey (requires free account)
BASESCAN_API_KEY=YOUR_BASESCAN_API_KEY_HERE

# -----------------------------------------------------------------------------
# Optional: Gas reporter
# -----------------------------------------------------------------------------
# Set to "true" when running `npx hardhat test` to print a gas usage table.
REPORT_GAS=false

# CoinMarketCap key for USD gas cost estimates in the gas reporter (optional).
# Get a free key: https://pro.coinmarketcap.com/signup
COINMARKETCAP_API_KEY=
