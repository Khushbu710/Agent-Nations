# =============================================================================
# Agent Nations Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in all values before running.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# xAI Grok API
# -----------------------------------------------------------------------------
# Your xAI API key. Obtain one at https://console.x.ai
# All minister and governor LLM calls use this key.
XAI_API_KEY=xai-YOUR_KEY_HERE

# Grok model to use.
# Recommended: grok-3-mini (fast, cheap, excellent structured output)
# Alternative: grok-3 (more capable, slower, higher cost)
GROK_MODEL=grok-3-mini

# Maximum tokens the model may generate per response.
# 512 is sufficient for proposals and verdicts.
GROK_MAX_TOKENS=512

# Temperature controls creativity vs determinism.
# 0.7 gives natural-sounding reasoning without being too random.
GROK_TEMPERATURE=0.7

# -----------------------------------------------------------------------------
# Blockchain (added for blockchain integration milestone)
# -----------------------------------------------------------------------------
# Base Sepolia RPC endpoint.
# Alchemy: https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
# QuickNode: https://YOUR_ENDPOINT.base-sepolia.quiknode.pro/YOUR_KEY/
# Public fallback (unreliable for demos): https://sepolia.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Private key of the executor wallet (holds EXECUTOR_ROLE on the contract).
# Must be funded with Base Sepolia ETH.
# Format: 64-char hex WITHOUT 0x prefix, or WITH — both work with ethers v6.
PRIVATE_KEY=0xYOUR_EXECUTOR_PRIVATE_KEY_HERE

# Deployed contract address on Base Sepolia.
# Populated automatically by the deploy script; copy from deployments/baseSepolia.json.
CONTRACT_ADDRESS=0xYOUR_CONTRACT_ADDRESS_HERE
